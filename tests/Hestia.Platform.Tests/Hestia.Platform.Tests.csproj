<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 test projects are self-running executables (Microsoft Testing Platform). -->
    <OutputType>Exe</OutputType>
    <!-- See Hestia.Modules.Sample.Tests: short in-process calls, no cancellation tokens. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!-- The event inbox tests (T36) use a small DbContext on the in-memory provider. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hestia.Platform\Hestia.Platform.csproj" />
  </ItemGroup>

</Project>
