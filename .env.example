# Copy to .env (never committed) and set a real password.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=Hestia
# The finance backend, by container name on the "finance" network (this is the default).
# FINANCE_API_URL=http://personal-finance-api:8080

# Sign-in (T03). The private key of the gateway tokens for finance (required). Make it with the commands in the README,
# section "Sign-in". Finance gets the public key of the same pair.
GATEWAY_SIGNING_KEY=
# Optional: an account that the host makes when it starts. Or import the finance account once (README, "Sign-in").
# HESTIA_USERNAME=
# HESTIA_PASSWORD=
# HESTIA_RESET_PASSWORD=false
# Optional: a read-only bearer token (32 characters or more) for scripts. Empty turns it off.
# HESTIA_READONLY_TOKEN=

# The local time zone (IANA). It sets the backup time, the day of the Today cards (T08), and the day of the alert rules (T15). Use the same zone as
# finance. The default is America/Toronto.
# TZ=America/Edmonton

# Nightly database dumps (docker/backup.sh), in the Docker volume "hestia_backups" by default.
# BACKUP_DIR can also be a folder on this machine (for example ./backups): then set BACKUP_UID and
# BACKUP_GID to its owner (`id -u`, `id -g`), so the dumps belong to you.
# BACKUP_DIR=hestia_backups
BACKUP_AT=03:00
BACKUP_KEEP_DAYS=14
# BACKUP_UID=999
# BACKUP_GID=999
# T99: after each dump, restore it into a scratch database and check it (true or false).
# BACKUP_VERIFY=true
# T99: the status folder of the finance backups, so Hestia also checks them (alerts on Today).
# FINANCE_BACKUP_STATUS_DIR=/opt/finance/backend/backups/status

# Documents (T11): the Tesseract language(s) of the OCR, for example eng or eng+fra. The image has English only; another
# language needs its package (tesseract-ocr-fra) in the Dockerfile.
# DOCUMENTS_OCR_LANGUAGE=eng

# The finance events (T04). The broker runs in the finance project (its "events" profile). Use the same user and
# password as there. Empty: the host gets no finance events; the module events in the host still work.
# EVENTS_RABBITMQ_URL=amqp://hestia:change-me@rabbitmq:5672
# A debug consumer that logs every event (true or false).
# EVENTS_LOG_ALL=false

# Email to the Inbox (T102): a mailbox that only Hestia reads (for Gmail: an app password). Only the allowed senders
# (addresses, or @domain) count: anyone can send to the address.
# INBOX_MAIL_ENABLED=true
# INBOX_MAIL_HOST=imap.gmail.com
# INBOX_MAIL_USERNAME=hestia.inbox@gmail.com
# INBOX_MAIL_PASSWORD=
# INBOX_MAIL_ALLOWED_SENDERS=you@gmail.com
