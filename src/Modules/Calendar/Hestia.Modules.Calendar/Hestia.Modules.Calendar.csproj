  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Hestia.Platform\Hestia.Platform.csproj" />
    <ProjectReference Include="..\Hestia.Modules.Calendar.Contracts\Hestia.Modules.Calendar.Contracts.csproj" />
  </ItemGroup>

</Project>
