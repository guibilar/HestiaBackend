<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- Needed at design time for `dotnet ef` (startup project). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- The OpenAPI document of the module endpoints, at /openapi/v1.json (T08). -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- The finance proxy (Gateway/FinanceProxy.cs). -->
    <PackageReference Include="Yarp.ReverseProxy" />
    <!-- Events: in-process module events and the finance events from RabbitMQ (Events/HestiaEvents.cs). -->
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hestia.Platform\Hestia.Platform.csproj" />
    <ProjectReference Include="..\Hestia.Contracts\Hestia.Contracts.csproj" />
  </ItemGroup>

  <!-- The modules. The host finds them at start (ModuleLoader); a reference here is all it needs. -->
  <ItemGroup Label="Modules">
    <ProjectReference Include="..\Modules\Alerts\Hestia.Modules.Alerts\Hestia.Modules.Alerts.csproj" />
    <ProjectReference Include="..\Modules\Documents\Hestia.Modules.Documents\Hestia.Modules.Documents.csproj" />
    <ProjectReference Include="..\Modules\Identity\Hestia.Modules.Identity\Hestia.Modules.Identity.csproj" />
    <ProjectReference Include="..\Modules\Sample\Hestia.Modules.Sample\Hestia.Modules.Sample.csproj" />
    <ProjectReference Include="..\Modules\Today\Hestia.Modules.Today\Hestia.Modules.Today.csproj" />
  </ItemGroup>

</Project>
